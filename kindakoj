---------------------------------------------------------------------
-- Verifikasi
---------------------------------------------------------------------
local FATAL = { invalid = true, revoked = true, expired = true, hwid_mismatch = true } -- key tersimpan dihapus
local busy = false

local function verifyKey(key)
    if busy then return end
    key = string.upper((tostring(key or ""):gsub("%s", "")))
    if key == "" then setStatus("Masukkan key dulu", C.warn) return end
    if not HWID then setStatus("HWID perangkat tidak tersedia, executor tidak didukung", C.bad) return end
    busy = true
    setStatus("Memverifikasi...", C.warn)

    -- lepas sesi dari eksekusi sebelumnya supaya tidak dianggap "sedang dipakai"
    if type(G.__KnearLicStop) == "function" then
        pcall(G.__KnearLicStop)
        G.__KnearLicStop = nil
        task.wait(0.6)
    end

    local data, err = post("/verify", { key = key, hwid = HWID })
    if not data then
        setStatus("Gagal terhubung ke server: " .. tostring(err), C.bad)
        busy = false
        return
    end
    if not data.ok then
        setStatus(tostring(data.msg or data.code or "Verifikasi gagal"), C.bad)
        if FATAL[data.code] and isfile and delfile then
            pcall(function() if isfile(CONFIG.KEYFILE) then delfile(CONFIG.KEYFILE) end end)
        end
        busy = false
        return
    end

    local fn, lerr = loadstring(data.script)
    if not fn then
        post("/stop", { key = key, sid = data.sid })
        setStatus("Script gagal dimuat: " .. tostring(lerr), C.bad)
        busy = false
        return
    end
    if writefile then pcall(writefile, CONFIG.KEYFILE, key) end
    setStatus("Verifikasi berhasil, membuka script...", C.ok)
    if data.expires_at then notify("Lisensi aktif. Sisa " .. fmtDur(data.expires_at - data.now))
    else notify("Lisensi permanen aktif") end
    task.wait(0.3)
    destroyGui()
    busy = false
    local ok, e = pcall(fn)
    if not ok then warn("[K NEAR] " .. tostring(e)) end
end

buildGui()
VerifyBtn.MouseButton1Click:Connect(function() verifyKey(KeyBox.Text) end)
KeyBox.FocusLost:Connect(function(enter) if enter then verifyKey(KeyBox.Text) end end)

if not HWID then
    setStatus("HWID perangkat tidak tersedia, executor tidak didukung", C.bad)
elseif not req then
    setStatus("Executor tidak mendukung request HTTP", C.bad)
else
    -- key tersimpan -> masuk otomatis
    local saved
    if isfile and readfile then
        pcall(function() if isfile(CONFIG.KEYFILE) then saved = readfile(CONFIG.KEYFILE) end end)
    end
    if saved and #saved > 0 then
        KeyBox.Text = saved
        task.spawn(verifyKey, saved)
    end
end
