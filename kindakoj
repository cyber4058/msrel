---------------------------------------------------------------------
-- SHA-256 (murni Luau) untuk membuat HWID
---------------------------------------------------------------------
local SHA_K = {
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}
local SHA_H = {
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
}
local function sha256(msg)
    local band, bxor, bnot, rrot, rshift = bit32.band, bit32.bxor, bit32.bnot, bit32.rrotate, bit32.rshift
    local len = #msg
    msg = msg .. "\128" .. string.rep("\0", (55 - len) % 64) .. string.pack(">I8", len * 8)
    local h = { table.unpack(SHA_H) }
    local w = table.create(64, 0)
    for chunk = 1, #msg, 64 do
        for i = 0, 15 do w[i + 1] = string.unpack(">I4", msg, chunk + i * 4) end
        for i = 17, 64 do
            local a, b = w[i - 15], w[i - 2]
            local s0 = bxor(rrot(a, 7), rrot(a, 18), rshift(a, 3))
            local s1 = bxor(rrot(b, 17), rrot(b, 19), rshift(b, 10))
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) % 4294967296
        end
        local a, b, c, d, e, f, g, hh = h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8]
        for i = 1, 64 do
            local S1 = bxor(rrot(e, 6), rrot(e, 11), rrot(e, 25))
            local ch = bxor(band(e, f), band(bnot(e), g))
            local t1 = (hh + S1 + ch + SHA_K[i] + w[i]) % 4294967296
            local S0 = bxor(rrot(a, 2), rrot(a, 13), rrot(a, 22))
            local maj = bxor(band(a, b), band(a, c), band(b, c))
            local t2 = (S0 + maj) % 4294967296
            hh, g, f, e, d, c, b, a = g, f, e, (d + t1) % 4294967296, c, b, a, (t1 + t2) % 4294967296
        end
        h[1] = (h[1] + a) % 4294967296 h[2] = (h[2] + b) % 4294967296
        h[3] = (h[3] + c) % 4294967296 h[4] = (h[4] + d) % 4294967296
        h[5] = (h[5] + e) % 4294967296 h[6] = (h[6] + f) % 4294967296
        h[7] = (h[7] + g) % 4294967296 h[8] = (h[8] + hh) % 4294967296
    end
    local out = {}
    for i = 1, 8 do out[i] = string.format("%08x", h[i]) end
    return table.concat(out)
end

---------------------------------------------------------------------
-- HWID: id perangkat (RbxAnalytics ClientId). gethwid() executor hanya cadangan.
---------------------------------------------------------------------
local function getHwid()
    local raw
    local ok, id = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
    if ok and type(id) == "string" and #id > 4 then raw = id end
    if not raw and type(gethwid) == "function" then
        local ok2, v = pcall(gethwid)
        if ok2 and v then raw = tostring(v) end
    end
    if not raw then return nil end
    return sha256("KNEAR|" .. raw)
end

---------------------------------------------------------------------
-- HTTP
---------------------------------------------------------------------
local req = (syn and syn.request) or (http and http.request) or http_request or request
local function post(path, tbl)
    if not req then return nil, "Executor tidak mendukung request HTTP" end
    local ok, res = pcall(req, {
        Url = CONFIG.API .. path, Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = HttpService:JSONEncode(tbl),
    })
    if not ok then return nil, tostring(res) end
    if type(res) ~= "table" then return nil, "respon kosong" end
    local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body or "") end)
    if not ok2 or type(data) ~= "table" then
        return nil, "respon server tidak valid (HTTP " .. tostring(res.StatusCode) .. ")"
    end
    return data
end

local function fmtDur(s)
    s = math.max(0, math.floor(s))
    local d, h, m = s // 86400, (s % 86400) // 3600, (s % 3600) // 60
    if d > 0 then return d .. " hari " .. h .. " jam" end
    if h > 0 then return h .. " jam " .. m .. " menit" end
    return m .. " menit"
end

local function notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "K NEAR", Text = text, Duration = 8 })
    end)
end

